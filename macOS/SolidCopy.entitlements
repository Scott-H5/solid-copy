<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements: the permissions the app asks macOS for.

  The App Sandbox keeps the app in its own container, so it can only reach
  what it has asked for here. The Mac App Store requires it.
-->
<plist version="1.0">
<dict>
	<!-- Turn on the App Sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!--
	  Make outgoing network connections: callsign lookups (QRZ, HamQTH,
	  callook.info), log uploads, and a rigctld you run yourself (Hamlib NET
	  rigctl, on 127.0.0.1 or another address).
	-->
	<key>com.apple.security.network.client</key>
	<true/>
	<!--
	  Accept connections from programs on this Mac only (127.0.0.1): with
	  "Share the radio with other programs" on, iDigi or WSJT-X reach the
	  radio through Solid Copy (RigctlServer.swift).
	-->
	<key>com.apple.security.network.server</key>
	<true/>
	<!--
	  Read and write files you pick in an Open or Save dialog: ADIF
	  import and export, and importing a log file in the SQL format.
	-->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!--
	  Remember a folder you chose (Settings > LoTW: where Solid Copy and
	  TQSL swap files), so it can be used again after a restart.
	-->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!--
	  Use the radio's serial (USB) port: the built-in driver for Kenwood and
	  Elecraft radios talks to it directly.
	-->
	<key>com.apple.security.device.serial</key>
	<true/>
</dict>
</plist>
